# Dépendances (Trop lourdes pour Git)
node_modules/
.next/
out/
build/

# Fichiers Sensibles (À NE JAMAIS PARTAGER)
.env
.env.local
.env.test
.env.development
.env.production
.env.staging
.env.development.local
.env.test.local
.env.production.local
*.db
*.sqlite

# Les .env.example sont volontairement versionnés (modèles publics)
!.env*.example

# Caches de build
*.tsbuildinfo

# Binaire du daemon Go (compilé sur le VPS au déploiement)
daemon/bin/

# Logs et Fichiers Temporaires
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Espace de travail local (non versionné)
scratch/

# Exports locaux de la base (données réelles — à ne jamais versionner)
data/db-export*/

# État interne de l'app Freebuff
.freebuff/

# Transcript de la session Codebuff (privé, trop lourd)
past_convo.json

# Logs et données locales du daemon Go (écrits à l'exécution)
daemon/logs/

# Personnalisation locale du daemon (plist de dev Mac, hors VPS)
scripts/fr.lassez.dev-daemon.plist

# Fichiers OSINT (vidéos temporaires)
radar_lassez/tmp-videos/
public/uploads/

# Médias locaux (exports/images de travail, non versionnés)
media/

# Archives de transfert (On en a plus besoin)
*.zip
*.tar.gz

# Dossiers spécifiques de build Mac/Windows
__MACOSX/
.vscode/
.idea/

# Bases SQLite lourdes (récupérables via VPS / backups locaux)
data/pipeline.db*
data/*.bak
# Bases par élection (data/elections/{slug}.db) + registre
# (couverts par *.db ci-dessus, mais explicite pour le registre JSON)
data/elections/

# Builds studio
apps/studio/dist/

# Secrets locaux du daemon (clés API plateformes — écrits par le studio via /api/secrets)
daemon/config/.secrets.yaml
daemon/config/.secrets.yaml.bak

# Backups automatiques de config.yaml (créés par le daemon à chaque sauvegarde)
daemon/config/*.bak

