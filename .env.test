# Quick test environment for Payload monolith
# Usage (PowerShell): Copy-Item .env.test .env.local -Force

NODE_ENV=development

# Site and Payload URLs (single Next app)
NEXT_PUBLIC_SITE_URL=http://localhost:5173
PAYLOAD_SERVER_URL=http://localhost:5173
PAYLOAD_API_URL=http://localhost:5173/api/payload

# CMS switch
CMS_PROVIDER=payload

# Payload security
PAYLOAD_SECRET=test_only_change_this_secret_32_chars_minimum

# Supabase Postgres (replace YOUR_PASSWORD)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.gdmvxijcxzcuassezrwy.supabase.co:5432/postgres

# Cache sync (test mode)
RADAR_CACHE_SYNC_SECRET=test-cache-sync-secret
RADAR_CACHE_SYNC_ENFORCE_IPS=false
RADAR_CACHE_SYNC_ALLOWED_IPS=

# Optional Radar auth for local dashboard tests
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=admin_test_password_change_me
RADAR_SESSION_SECRET=test_session_secret_change_me_32_chars_minimum

# Optional publish pipeline URL
FRONTEND_URL=http://localhost:5173
