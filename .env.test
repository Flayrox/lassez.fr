# Test/local profile overrides only.
# 1) Copy .env.example to .env
# 2) Apply only the overrides below for local tests.

NODE_ENV=development

NEXT_PUBLIC_SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PAYLOAD_SERVER_URL=http://localhost:5173
PAYLOAD_API_URL=http://localhost:5173/api/payload

PAYLOAD_SECRET=test_only_change_this_secret_32_chars_minimum
RADAR_CACHE_SYNC_SECRET=test-cache-sync-secret
RADAR_CACHE_SYNC_ENFORCE_IPS=false
RADAR_CACHE_SYNC_ALLOWED_IPS=
