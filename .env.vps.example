# ----------------------------
# VPS deployment configuration
# ----------------------------

NODE_ENV=production

# Public hostnames
NEXT_PUBLIC_SITE_URL=https://lassez.fr
FRONTEND_URL=https://lassez.fr
RADAR_API_URL=https://studio.lassez.fr/api/radar/nav

# CMS routing
CMS_PROVIDER=payload
PAYLOAD_SERVER_URL=https://api.lassez.fr
PAYLOAD_API_URL=https://api.lassez.fr/api/payload
PAYLOAD_SECRET=replace_me_payload_secret_32_chars_min
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.example.supabase.co:5432/postgres

# Radar auth
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=replace_me_admin_password
RADAR_SESSION_SECRET=replace_me_radar_session_secret_32_chars_min

# Cache sync security
RADAR_CACHE_SYNC_SECRET=replace_me_cache_sync_hmac_32_chars_min
RADAR_CACHE_SYNC_WEBHOOK_URL=https://lassez.fr/api/internal/cache-sync
RADAR_CACHE_SYNC_ENFORCE_IPS=true
RADAR_CACHE_SYNC_ALLOWED_IPS=116.203.158.47

# Optional service keys
GEMINI_API_KEY=
DISCORD_WEBHOOK_URL=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# -----------------------------
# deploy:vps helper env values
# -----------------------------
# Put these in your shell (not in server .env)
# VPS_HOST=116.203.158.47
# VPS_PORT=22
# VPS_USER=root
# VPS_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----..."
# VPS_REMOTE_DIR=/var/www/lassez-prod
# VPS_GIT_BRANCH=main
# VPS_INSTALL_COMMAND=npm ci
# VPS_BUILD_COMMAND=npm run build
# VPS_RESTART_COMMAND=pm2 startOrReload ecosystem.config.cjs ; pm2 save
