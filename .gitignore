# Dépendances (Trop lourdes pour Git)
node_modules/
.next/
out/
build/

# Fichiers Sensibles (À NE JAMAIS PARTAGER)
.env
.env.local
.env.test
.env.development.local
.env.test.local
.env.production.local
*.db
*.sqlite

# Caches de build
*.tsbuildinfo

# Binaire du daemon Go (compilé sur le VPS au déploiement)
daemon/bin/

# Logs et Fichiers Temporaires
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Espace de travail local (non versionné)
scratch/

# Exports locaux de la base (données réelles — à ne jamais versionner)
data/db-export*/

# État interne de l'app Freebuff
.freebuff/

# Fichiers OSINT (vidéos temporaires)
radar_lassez/tmp-videos/
public/radar-images/
public/uploads/

# Archives de transfert (On en a plus besoin)
*.zip
*.tar.gz

# Dossiers spécifiques de build Mac/Windows
__MACOSX/
.vscode/
.idea/

# Bases SQLite lourdes (récupérables via VPS / backups locaux)
data/radar.db*
data/*.bak

# Builds labo
apps/labo/dist/

# Secrets locaux du daemon (clés API plateformes — écrits par le labo via /api/secrets)
daemon/config/.secrets.yaml
daemon/config/.secrets.yaml.bak

# Backups automatiques de config.yaml (créés par le daemon à chaque sauvegarde)
daemon/config/*.bak

