# Core app URLs
NEXT_PUBLIC_SITE_URL=https://lassez.fr
PAYLOAD_SERVER_URL=https://api.lassez.fr
PAYLOAD_API_URL=https://api.lassez.fr/api/payload

# CMS switch
CMS_PROVIDER=payload

# Payload security
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Supabase Postgres (direct host or Session Pooler URL)
# Example with provided host:
# postgresql://postgres:YOUR_PASSWORD@db.gdmvxijcxzcuassezrwy.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.gdmvxijcxzcuassezrwy.supabase.co:5432/postgres

# Cache-sync webhook security
RADAR_CACHE_SYNC_SECRET=replace-with-shared-hmac-secret
RADAR_CACHE_SYNC_ENFORCE_IPS=true
RADAR_CACHE_SYNC_ALLOWED_IPS=
