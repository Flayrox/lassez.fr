[TEMPLATE] Front L'Assez — clean
# Copy to .env and fill values.

NODE_ENV=production

# Core URLs
NEXT_PUBLIC_SITE_URL=https://lassez.fr
FRONTEND_URL=https://lassez.fr

# SMTP (optionnel : si vide, les emails sont loggés en console en dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=L'Assez <noreply@lassez.fr>

# External services (optionnel)
GEMINI_API_KEY=
DISCORD_WEBHOOK_URL=

# Social APIs (optionnel)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
