# Configuration pour le déploiement multi-site LASSEZ V3

# ============================
# CONFIGURATION FRONTEND (Port 3000)
# ============================
# Variables pour lassez.fr (Frontend principal)

NEXT_PUBLIC_PAYLOAD_URL=https://api.lassez.fr
PAYLOAD_URL=http://localhost:3001
FRONTEND_URL=https://lassez.fr
RADAR_STUDIO_URL=https://studio.lassez.fr
NODE_ENV=production
PORT=3000

# ============================
# CONFIGURATION API PAYLOAD (Port 3001)
# ============================
# Variables pour api.lassez.fr (Payload CMS)

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/lassez
PAYLOAD_SECRET=your-secret-key-here
PAYLOAD_PUBLIC_SERVER_URL=https://api.lassez.fr
CORS_URLS=https://lassez.fr,https://studio.lassez.fr,http://localhost:3000,http://localhost:3002
PAYLOAD_PORT=3001
NODE_ENV=production

# ============================
# CONFIGURATION STUDIO RADAR (Port 3002)
# ============================
# Variables pour studio.lassez.fr (Radar Studio)

NEXT_PUBLIC_PAYLOAD_URL=https://api.lassez.fr
PAYLOAD_URL=http://localhost:3001
FRONTEND_URL=https://lassez.fr
STUDIO_URL=https://studio.lassez.fr
NEXT_PUBLIC_API_URL=https://api.lassez.fr
NODE_ENV=production
PORT=3002

# ============================
# CONFIGURATION DAEMON RADAR
# ============================

PAYLOAD_URL=http://localhost:3001
PAYLOAD_BOT_EMAIL=bot@lassez.fr
PAYLOAD_BOT_PASSWORD=your-bot-password-here
PAYLOAD_DEFAULT_CATEGORY=12

# Réseaux sociaux
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_TOKEN_SECRET=

# IA & Scraping
GEMINI_API_KEY=
BING_SEARCH_API_KEY=

# ============================
# CONFIGURATION LOCALE (dev)
# ============================

NEXT_TELEMETRY_DISABLED=1
