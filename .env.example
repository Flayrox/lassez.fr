# Canonical environment template (single source)
# Copy to .env and fill values.

NODE_ENV=production

# Core URLs
NEXT_PUBLIC_SITE_URL=https://lassez.fr
FRONTEND_URL=https://lassez.fr
RADAR_API_URL=https://studio.lassez.fr/api/radar/nav

# CMS / Payload
CMS_PROVIDER=payload
PAYLOAD_SERVER_URL=https://api.lassez.fr
PAYLOAD_API_URL=https://api.lassez.fr/api/payload
PAYLOAD_SECRET=replace_me_payload_secret_32_chars_min
PAYLOAD_PREVIEW_SECRET=replace_me_preview_hmac_secret_32_chars_min
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.gdmvxijcxzcuassezrwy.supabase.co:5432/postgres

# Radar auth
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=replace_me_admin_password
RADAR_SESSION_SECRET=replace_me_radar_session_secret_32_chars_min

# Cache sync
RADAR_CACHE_SYNC_SECRET=replace_me_cache_sync_hmac_32_chars_min
RADAR_CACHE_SYNC_WEBHOOK_URL=https://lassez.fr/api/internal/cache-sync
RADAR_CACHE_SYNC_ENFORCE_IPS=true
RADAR_CACHE_SYNC_ALLOWED_IPS=

# External services
GEMINI_API_KEY=
DISCORD_WEBHOOK_URL=

# Payload CMS Bot (optional)
PAYLOAD_BOT_URL=https://api.lassez.fr/
PAYLOAD_BOT_USER=
PAYLOAD_BOT_PASSWORD=
PAYLOAD_BOT_CATEGORY_ID=12

# Social APIs
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
